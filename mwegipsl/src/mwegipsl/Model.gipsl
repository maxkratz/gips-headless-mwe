package "mwegipsl"
import "platform:/resource/mwemetamodel/model/Mwemetamodel.ecore"

config {
	solver := GUROBI;
	timeLimit := true [value := 10.0];
	randomSeed := true [value := 0];
	presolve := auto;
	debugOutput := true;
}

// GT rule that can be used to assign a guest to a host
rule assignGuestToHost {
	h: Host {
		++ -guests -> g
	}

	g: Guest {
		++ -hostedBy -> h
	}
}

// GT pattern to find guests that are already assigned to a host
pattern guestHasHost {
	h: Host {
		- guests -> g
	}
	g: Guest {
		- hostedBy -> h
	}
}

// Mapping to create binary MILP variables for each match of the GT rule
mapping assignment to assignGuestToHost;

// Every non-assigned guest must be assigned to a host
constraint with Guest {
	mappings.assignment->join(g)->sum(element.value)
	+
	patterns.guestHasHost->join(g)->sum(1)
	== 1
}

// The capacity of a host must not be violated
constraint with Host {
	mappings.assignment->join(h)->sum(element.value)
	+
	patterns.guestHasHost->join(h)->sum(1)
	<= context.capacity
}

// Local objective function: number of new assignments
function newAssignments with assignment {
	context.value
}

// Goal: maximize new assignments
objective : max {
	functions.newAssignments
}
